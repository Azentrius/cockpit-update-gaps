# shellcheck shell=sh
# After every install and upgrade of cockpit-update-gaps (as root; also `make install`).
# SPDX-License-Identifier: Apache-2.0
#
# The timer stays as it was: off on a new install (it is set up from the page), on after an
# upgrade if it was on. A timer that is on gets a scan right away, so the state has the format
# of this version.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    if systemctl is-enabled --quiet update-gaps-scan.timer 2> /dev/null; then
        systemctl restart update-gaps-scan.timer || true
        systemctl start --no-block update-gaps-scan.service || true
    fi
fi
